# whitelist-style: everything is ignored except what this project publishes
*

# --- published: the app and its engine ---
!src/
!src/**
!palette-wallpaper/
!palette-wallpaper/**
# built artifacts stay out entirely (screenshots for README live in docs/img)
palette-wallpaper/out/
!docs/
!docs/**
!privacy.html
!package.json
!package-lock.json

# --- published: community & legal ---
!LICENSE
!NOTICE.md
!README.md
!README.en.md
!CHANGELOG.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!.github/
!.github/**
!.gitignore

# --- but never these, anywhere ---
node_modules/
out/**/deps/
palette-wallpaper/out/deps/
**/*.log
settings.json

# --- published: cross-AI collaboration protocol ---
!AGENTS.md
!collab/
!collab/**
# locks are transient state, never committed
collab/locks/
